# Required: MongoDB connection string
MONGO_URI=mongodb://localhost:27017/academy_timetable

# Required: Server port
PORT=4000

# Required: Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Required: A cryptographically random secret for JWT signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. The server will refuse to start if this is missing.
JWT_SECRET=

# Environment: development | production
NODE_ENV=development